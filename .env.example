# JEXXXUS Native AI Gateway Configuration

# OpenAI API Key (for GPT-4o)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic API Key (for Claude - optional)
ANTHROPIC_API_KEY=sk-your-anthropic-key

# Google API Key (for Gemini - optional)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-key

# Vercel AI Gateway (optional - for unified routing)
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Clerk Authentication (if using auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Kingdom Agent — live vault reads via JEXXXUS | API (default https://api.jexxx.us)
JEXXXUS_API_URL=https://api.jexxx.us
# Set JEXXXUS_ACCOUNT_API=off to force direct Supabase from blxckchat (fallback path)

# Kingdom Agent — direct Supabase fallback when API is unreachable
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Optional super-admin elevation for asUserId reads
SUPABASE_SERVICE_ROLE_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paddle Billing (Primary for BLXCKCHAT)
NEXT_PUBLIC_PRIMARY_PAYMENT_PROVIDER=paddle
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID_DEVOTEE=pri_...
NEXT_PUBLIC_PADDLE_PRICE_ID_WHALE=pri_...
NEXT_PUBLIC_PADDLE_PRICE_ID_MELCHIZEDEK=pri_...
PADDLE_PRICE_ID_DEVOTEE=pri_...
PADDLE_PRICE_ID_WHALE=pri_...
PADDLE_PRICE_ID_MELCHIZEDEK=pri_...
PADDLE_API_KEY=pdl_live_... # or pdl_sdbx_...
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_...