# Sacred Environment Configuration for JEXXXUS Payment Empire
# Adult-friendly payment processing configuration

# =============================================================================
# PRIMARY PAYMENT PROCESSOR: CCBill (Adult-Friendly, Production)
# =============================================================================

# CCBill Merchant Account (Main Production)
CCBILL_CLIENT_NUM=your_ccbill_client_number
CCBILL_SUBACCOUNT=your_ccbill_subaccount
CCBILL_FORM_MISTRESS=284ccbill_mistress
CCBILL_FORM_CONCU=284ccbill_concu
CCBILL_FORM_MIDWIFE=284ccbill_midwife

# CCBill API Configuration
CCBILL_API_KEY=your_ccbill_api_key
CCBILL_SECRET=your_ccbill_webhook_secret

# =============================================================================
# BACKUP/TESTING PAYMENT PROCESSOR: Paddle (Sandbox/Testing)
# =============================================================================

# Paddle Configuration
PADDLE_API_KEY=your_paddle_api_key
PADDLE_CLIENT_TOKEN=your_paddle_client_token
NEXT_PUBLIC_PADDLE_ENV=sandbox # Use 'sandbox' for testing, 'live' for production

# Paddle Price IDs (Sandbox - replace with live IDs for production)
PADDLE_PRICE_MISTRESS=pri_01hxyz_mistress_sandbox
PADDLE_PRICE_CONCU=pri_01hxyz_concu_sandbox
PADDLE_PRICE_MIDWIFE=pri_01hxyz_midwife_sandbox

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Payment Provider Selection
# Use 'paddle' for testing/development, 'ccbill' for production
NEXT_PUBLIC_PAYMENT_PROVIDER=ccbill
# Or use feature flag: NEXT_PUBLIC_USE_TESTING_PAYMENTS=true

# Application URLs
NEXT_PUBLIC_APP_URL=https://blxckchat.jexxx.us
NEXT_PUBLIC_API_URL=https://api.blxckchat.jexxx.us

# Clerk Integration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# =============================================================================
# STRIPE BACKUP (Optional - for non-adult content)
# =============================================================================

STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# =============================================================================
# DATABASE & INFRASTRUCTURE
# =============================================================================

DATABASE_URL=your_database_connection_string
REDIS_URL=your_redis_connection_string

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================

JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
SENTRY_DSN=your_sentry_dsn

# =============================================================================
# CCBILL WEBHOOK ENDPOINTS
# =============================================================================

CCBILL_WEBHOOK_SECRET=your_ccbill_webhook_secret
CCBILL_SUCCESS_URL=https://blxckchat.jexxx.us/subscription/success
CCBILL_CANCEL_URL=https://blxckchat.jexxx.us/subscription/cancel

# =============================================================================
# PADDLE WEBHOOK ENDPOINTS
# =============================================================================

PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
PADDLE_SUCCESS_URL=https://blxckchat.jexxx.us/subscription/success
PADDLE_CANCEL_URL=https://blxckchat.jexxx.us/subscription/cancel

# =============================================================================
# NOTES FOR SETUP
# =============================================================================

# 1. CCBill Account Setup:
#    - Apply at https://www.ccbill.com/merchants/
#    - Get clientAccnum and subaccount numbers
#    - Create payment forms for each tier
#    - Configure webhook endpoints

# 2. Paddle Account Setup:
#    - Create account at https://paddle.com/
#    - Set up sandbox environment for testing
#    - Create products and prices for each tier
#    - Configure webhook endpoints

# 3. Testing Workflow:
#    - Use Paddle in development (NEXT_PUBLIC_PAYMENT_PROVIDER=paddle)
#    - Switch to CCBill for production (NEXT_PUBLIC_PAYMENT_PROVIDER=ccbill)
#    - Monitor webhooks for subscription updates
#    - Test tier upgrades and downgrades

# 4. Security Considerations:
#    - Never commit real API keys to version control
#    - Use different keys for different environments
#    - Implement proper webhook signature verification
#    - Store sensitive data encrypted at rest